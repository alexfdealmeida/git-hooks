#!/bin/bash

copyGitHooksScript="copy-git-hooks.sh"

echo "[pre-commit] Checking prerequisites for updating the hooks"
# O 'exit $?' evita que o bash continue lendo este arquivo caso ele seja sobrescrito pela auto-atualizacao.
! [ -f "$copyGitHooksScript" ] && echo "Skipped" || ( chmod +x "$copyGitHooksScript" && echo "Running the script '$copyGitHooksScript'" && ./$copyGitHooksScript --update-only-git-hooks ); exit $?
